# Canonical production origin used for metadata, sitemap and robots output.
NEXT_PUBLIC_SITE_URL=https://marcberghoff.com

# Public mailbox. The application safely falls back to marc@marcberghoff.com.
NEXT_PUBLIC_CONTACT_EMAIL=marc@marcberghoff.com

# Google Forms HTML endpoint. Open the published form, inspect its form action,
# and replace every placeholder below with the matching formResponse/entry value.
# These values are server-only: do not add NEXT_PUBLIC_ prefixes.
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
GOOGLE_FORM_ENTRY_FORM_TYPE=YOUR_ENTRY_FORM_TYPE
GOOGLE_FORM_ENTRY_FULL_NAME=YOUR_ENTRY_FULL_NAME
GOOGLE_FORM_ENTRY_EMAIL=YOUR_ENTRY_EMAIL
GOOGLE_FORM_ENTRY_PHONE=YOUR_ENTRY_PHONE
GOOGLE_FORM_ENTRY_COMPANY=YOUR_ENTRY_COMPANY
GOOGLE_FORM_ENTRY_ROLE=YOUR_ENTRY_ROLE
GOOGLE_FORM_ENTRY_COMPANY_SIZE=YOUR_ENTRY_COMPANY_SIZE
GOOGLE_FORM_ENTRY_SERVICE=YOUR_ENTRY_SERVICE
GOOGLE_FORM_ENTRY_URGENCY=YOUR_ENTRY_URGENCY
GOOGLE_FORM_ENTRY_MESSAGE=YOUR_ENTRY_MESSAGE
GOOGLE_FORM_ENTRY_CURRENT_SITUATION=YOUR_ENTRY_CURRENT_SITUATION
GOOGLE_FORM_ENTRY_DESIRED_OUTCOME=YOUR_ENTRY_DESIRED_OUTCOME
GOOGLE_FORM_ENTRY_REFERRAL=YOUR_ENTRY_REFERRAL
GOOGLE_FORM_ENTRY_DIAGNOSTIC_SUMMARY=YOUR_ENTRY_DIAGNOSTIC_SUMMARY
GOOGLE_FORM_ENTRY_CONSENT=YOUR_ENTRY_CONSENT

# Cal.com username and 30-minute event slug, without the domain. Example: marc/first-conversation
# The contact page shows a direct inline booking calendar when this is configured.
# Until then, booking links remain stable and the booking section shows an email fallback.
NEXT_PUBLIC_CAL_LINK=

# Optional public telephone number in international format. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_PHONE=

# Legal provider details. The Privacy and Imprint pages stay no-index until a
# business address is supplied. Confirm every value with the site owner or legal adviser.
LEGAL_NAME=Marc Berghoff
LEGAL_TRADING_NAME=
LEGAL_ADDRESS=
LEGAL_COUNTRY=Malta
LEGAL_REGISTRATION_VAT=
LEGAL_CONTENT_RESPONSIBLE=Marc Berghoff
LEGAL_CONTACT_RETENTION_PERIOD=as long as needed to handle the enquiry and meet applicable legal or accounting duties
LEGAL_DISPUTE_RESOLUTION_STATEMENT=
